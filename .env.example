# ============================================================================
#  .env mẫu cho Baby AI Alert — Raspberry Pi 4 (ARM64 / aarch64, CPU-only)
# ============================================================================
#  Cách dùng:
#       cp .env.example .env
#       # sửa TELEGRAM_TOKEN / TELEGRAM_CHAT_ID bên dưới, rồi chạy ./run.sh
#       chmod 600 .env        # bảo vệ token (chỉ owner đọc được)
#
#  GHI CHÚ QUAN TRỌNG:
#    Toàn bộ default hiệu năng (640x480, FPS 15, YOLO_EVERY 10, HEADLESS 1) đã
#    được hardcode SẴN trong src/main.py cho Raspberry Pi 4 — nên file .env này
#    KHÔNG bắt buộc cho phần camera/FPS. Việc DUY NHẤT thật sự cần là đặt
#    TELEGRAM_TOKEN + TELEGRAM_CHAT_ID thật của bạn (token demo dưới đây chỉ để
#    chạy thử). Các biến camera/detector bên dưới chỉ để override khi cần.
# ============================================================================

# --- Telegram (BẮT BUỘC thay trước khi deploy thật) ---
TELEGRAM_TOKEN=8684958351:AAHE0XavsY_DgzEevmtcMUHB3_N3QwuNYIk
TELEGRAM_CHAT_ID=7316578932

# ============================================================================
#  Các biến dưới đây ĐÃ là default trong code — chỉ bỏ comment khi muốn đổi.
# ============================================================================

# --- Camera (default code: 640x480 @15fps cho Pi 4) ---
# Camera đặt xa cũi → thử 800x600 trước khi lên 1280x720. Pi 4 yếu nên đừng để
# 720p (FPS tụt còn ~4-6 → ảnh mờ → mũi/miệng mất chi tiết → FALSE ALERT).
# CAMERA_WIDTH=640
# CAMERA_HEIGHT=480
# CAMERA_FPS=15

# --- YOLO (default code: chạy mỗi 10 frame) ---
# YOLO chỉ dùng khi MẤT mặt → xác nhận còn người trong khung không (phân biệt
# 'bé quay đầu/úp mặt' vs 'không còn ai'). Pi 4 không có NPU → YOLO buộc chạy CPU.
# YOLO_EVERY=10

# --- Ngưỡng thời gian cho các cảnh báo (giây) ---
# OCCLUSION_THRESHOLD_SEC=10   # che mũi/miệng kéo dài bao lâu thì báo
# FACE_LOST_SEC=15             # CÓ người (YOLO) mà MẤT MẶT bao lâu thì báo "nghi
#                              #   vùi/che kín" (vá ca mặt úp hẳn vào nệm → mất
#                              #   landmark → detector skin không đọc được). 0=tắt.
#                              #   Cần YOLO bật.

# --- 3 lớp GIẢM BÁO NHẦM khi bé nằm nghiêng/quay đầu (xem HUONG_DAN_BAO_VE §4.8) ---
# FACE_DETECT_CONF=0.5         # Lớp 1 BlazeFace: ngưỡng tin cậy phát hiện mặt phụ
#                              #   (bền góc nghiêng). Mặt nghiêng vẫn thấy → KHÔNG báo.
# FACE_LOST_PROFILE_YAW=0.55   # Lớp 3 head-pose: |yaw|≥ngần này ngay trước khi mất
#                              #   mặt = đang nằm nghiêng → báo NHẸ; nhỏ hơn = nghi
#                              #   bị che đột ngột → báo KHẨN ngay. (0=chính diện, 1=nghiêng hẳn)
# FACE_LOST_ESCALATE_SEC=30    # Lớp 2 leo thang: ca 'nằm nghiêng' kéo dài ≥ ngần này
#                              #   giây thì nâng từ nhắc NHẸ lên cảnh báo KHẨN.
# NO_PERSON_SEC=15             # không thấy ai trong khung bao lâu → trạng thái "mất
#                              #   người" (CHỈ hiển thị/log, KHÔNG gửi cảnh báo)
# PRESENCE_HOLD_SEC=2.0        # giữ "có người" sau khi mất tín hiệu (chống rớt track Pi 4)

# --- Thông báo khởi động ---
# STARTUP_NOTIFY=0             # DEFAULT MỚI = 0 (TẮT). Khi 0: KHÔNG yêu cầu đưa mặt
#                              #   vào khung, KHÔNG gửi "đang quét tìm bé" / "vẫn chưa
#                              #   thấy bé" / "đã thấy bé bắt đầu giám sát". Calibration
#                              #   occlusion vẫn chạy THỤ ĐỘNG (im lặng) khi có mặt.
#                              #   Đặt =1 để bật lại hành vi cũ (backward-compat).
# CALIB_REMIND_SEC=60          # (chỉ có tác dụng khi STARTUP_NOTIFY=1)

# --- FACE-PRESENCE notify: báo "có khuôn mặt ổn định" (text-only, KHÔNG ảnh) ---
# Khi xuất hiện ≥1 khuôn mặt HỢP LỆ + ỔN ĐỊNH → gửi ĐÚNG MỘT tin Telegram TEXT.
# Mặt đứng nguyên KHÔNG lặp; chỉ báo lần sau khi TẤT CẢ mặt đã rời ổn định +
# cooldown hết. ĐÂY CHỈ LÀ FACE DETECTION — không nhận dạng danh tính, không
# khẳng định là "bé", KHÔNG lưu/gửi ảnh, KHÔNG lưu dữ liệu sinh trắc học.
# Độc lập hoàn toàn với pipeline an toàn (che mũi/miệng, mất mặt) — không làm yếu.
# FACE_PRESENCE_NOTIFY=1          # 1=bật (default), 0=tắt
# FACE_SCAN_EVERY_N=4             # chạy face analysis mỗi N frame (~3-4 lần/giây @15fps)
# FACE_PRESENCE_MIN_CONFIDENCE=0.6   # ngưỡng confidence detection
# FACE_PRESENCE_MIN_AREA_RATIO=0.02  # diện tích bbox tối thiểu / frame (chuẩn hóa)
# FACE_PRESENCE_CONFIRM_FRAMES=4     # số lần scan thấy mặt tối thiểu để xác nhận
# FACE_PRESENCE_CONFIRM_SEC=1.0      # thời gian tối thiểu để xác nhận
# FACE_EXIT_CONFIRM_FRAMES=5         # số lần scan KHÔNG mặt liên tiếp để coi là đã rời
# FACE_EXIT_CONFIRM_SEC=2.0          # thời gian không-mặt tối thiểu để coi là đã rời
# FACE_NOTIFY_COOLDOWN_SEC=30        # cooldown tối thiểu giữa 2 event face-presence

# --- Ổn định hơn nếu votes dao động vì FPS thấp ---
# CONFIRM_FRAMES=10        # tăng (15-20) → ổn định hơn, response chậm hơn chút
# SMOOTHER_MAX_MISS=3      # tăng (4-5) nếu landmark nhảy nhiều

# --- Autofocus: MẶC ĐỊNH BẬT (1). Đừng tắt trừ khi camera + trẻ cố định tuyệt
#     đối — giữ mặt nét để MediaPipe track ổn định. ---
# CAMERA_AUTOFOCUS=1

# --- Headless: Pi 4 chạy không màn hình (mặc định đã =1) ---
# HEADLESS=1
