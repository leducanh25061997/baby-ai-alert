# ============================================================================
#  Baby AI Alert — systemd service (autostart khi boot Raspberry Pi 4)
# ============================================================================
#  ĐÂY LÀ TEMPLATE. Đừng copy thẳng file này vào /etc/systemd/system/.
#  Chạy `sudo bash scripts/setup_autostart.sh` — script sẽ tự điền các
#  placeholder __USER__ / __GROUP__ / __PROJECT_DIR__ / __PYTHON__ cho đúng
#  máy của bạn rồi cài đặt.
#
#  (Nếu muốn cài tay: thay 4 placeholder bên dưới bằng giá trị thật.)
# ============================================================================

[Unit]
Description=Baby AI Alert Monitor (phat hien ngat tho tre em)
# network-online.target — chờ mạng THẬT SỰ lên (WiFi associate + DHCP + DNS)
# trước khi start, để alert Telegram đầu tiên sau boot không bị trượt vì mạng
# chưa sẵn. Đánh đổi: detection bắt đầu trễ ~15-30s MỘT LẦN lúc boot. App còn
# có warm-up + retry/backoff khi gửi (src/main.py) nên kể cả mạng lên trễ hơn
# nữa alert vẫn tới. Cần bật dịch vụ chờ mạng: `sudo systemctl enable
# NetworkManager-wait-online.service` (Bookworm dùng NetworkManager).
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__PROJECT_DIR__

# .env cần để đặt token Telegram thật (camera/FPS đã là default Pi 4 trong code).
# Xem INSTALL_PI4.md §7.
# Prefix `-` = không fail nếu file không tồn tại (default đã hardcode trong code).
EnvironmentFile=-__PROJECT_DIR__/.env

# (TUỲ CHỌN) Chờ USB webcam enumerate trước khi start cho gọn log. Bước này
# NON-FATAL: `exit 0` LUÔN trả về dù /dev/video0 chưa thấy sau 30s → KHÔNG chặn
# process khởi động. App (src/main.py) tự quản lý mở camera với BACKOFF CÓ GIỚI
# HẠN (_open_camera) và tự KẾT NỐI LẠI khi mất frame/unplug-replug — không phụ
# thuộc vào ExecStartPre này, cũng không crash khi thiếu /dev/video*, permission
# denied, hay camera bị app khác giữ. (Có thể bỏ hẳn dòng ExecStartPre nếu muốn.)
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do [ -e /dev/video0 ] && exit 0; sleep 1; done; echo "[setup] /dev/video0 chua thay sau 30s, van start (app tu reconnect)"; exit 0'

ExecStart=__PYTHON__ __PROJECT_DIR__/src/main.py

# App crash / camera mất / OOM → tự khởi động lại sau 10s. KHÔNG bao giờ bỏ cuộc.
Restart=always
RestartSec=10

# Tự restart nếu rò rỉ bộ nhớ vượt 1GB (phòng xa cho chạy 24/7 nhiều tháng).
MemoryMax=1G

# Ghi log (heartbeat tiếng Việt + alert) ra file để vận hành theo dõi.
StandardOutput=append:/var/log/baby-monitor.log
StandardError=append:/var/log/baby-monitor.log

[Install]
WantedBy=multi-user.target
